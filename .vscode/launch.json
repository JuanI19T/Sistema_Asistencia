{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Proyecto: API + App (F5)",
      "configurations": [
        "API: Node.js",
        "App: Expo QR"
      ],
      "stopAll": true,
      "presentation": {
        "group": "1",
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      "name": "API: Node.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Api/index.js",
      "cwd": "${workspaceFolder}/Api",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": true,
      "presentation": {
        "group": "2",
        "order": 1
      }
    },
    {
      "name": "App: Expo QR",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/App/node_modules/expo/bin/cli",
      "args": [
        "start"
      ],
      "cwd": "${workspaceFolder}/App",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "restart": false,
      "presentation": {
        "group": "1",
        "order": 1
      }
    },
    {
      "name": "App: Depuracion Expo",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}/App",
      "bundlerHost": "127.0.0.1",
      "bundlerPort": "8081",
      "enableTurboSourcemaps": true,
      "restart": true,
      "presentation": {
        "group": "3",
        "order": 1
      }
    }
  ]
}
