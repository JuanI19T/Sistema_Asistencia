{
  "expo": {
    "name": "AppAsistencia",
    "slug": "AppAsistencia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a $(PRODUCT_NAME) usar la cámara para escanear el QR de la clase",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.eest.appasistencia",
      "supportsTablet": true
    },
    "android": {
      "package": "com.eest.appasistencia",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "07e3e87e-f1a0-4681-baac-41cd3dfe5cad"
      }
    },
    "owner": "juani19t"
  }
}
