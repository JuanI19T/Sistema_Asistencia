# API de asistencia — configuracion local
# Copiá este archivo como .env y completá cada valor.
# OJO: .env está en .gitignore. Nunca lo subas a git.

# --- MySQL ---
# Local: el servidor de tu máquina.
# Railway: usá el host de la RED PRIVADA (mysql.railway.internal), no el proxy TCP.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_asistencia_eest
DB_USER=root
DB_PASS=cambiá_esto_por_tu_password

# --- Servidor ---
# Opcional: si no lo definís, la API escucha en el 3000.
# En Railway lo define la plataforma, no lo hardcodees.
PORT=3000

# --- Sesión / JWT ---
# String largo y aleatorio. Tiene que ser SIEMPRE el mismo:
# si falta o cambia, se invalidan todos los tokens y hay que volver a loguearse.
SESSION_SECRET=replace-with-a-long-random-value